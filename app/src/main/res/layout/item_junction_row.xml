<?xml version="1.0" encoding="utf-8"?><!--
  One junction row: icon, name, today's time, an enable switch, and the
  per-junction "remind me before" offset and "snooze for" controls.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_icon"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="26sp"
            tools:text="🌅" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Sunrise" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_placeholder"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="06:28 AM"
                tools:textColor="@color/sunrise_color" />

        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_tint"
            app:trackTint="@color/switch_track_tint" />

    </LinearLayout>

    <!--
      The reminder and snooze controls are Action chips (outlined, with an icon) so
      they clearly read as tappable settings rather than static labels. A ChipGroup
      wraps them to a second line on narrow screens instead of clipping.
    -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/config_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="44dp"
        app:chipSpacingVertical="4dp"
        app:singleLine="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/btn_offset"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="false"
            android:textColor="@color/text_primary"
            app:chipBackgroundColor="@color/card_bg"
            app:chipIcon="@drawable/ic_alarm"
            app:chipIconSize="16dp"
            app:chipIconTint="@color/accent"
            app:chipStrokeColor="@color/accent"
            app:chipStrokeWidth="1dp"
            app:ensureMinTouchTargetSize="true"
            tools:text="Remind 10 min before" />

        <com.google.android.material.chip.Chip
            android:id="@+id/btn_snooze"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="false"
            android:textColor="@color/text_primary"
            app:chipBackgroundColor="@color/card_bg"
            app:chipIcon="@drawable/ic_snooze"
            app:chipIconSize="16dp"
            app:chipIconTint="@color/text_secondary"
            app:chipStrokeColor="@color/card_stroke"
            app:chipStrokeWidth="1dp"
            app:ensureMinTouchTargetSize="true"
            tools:text="Snooze 10 min" />

    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/tv_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingTop="2dp"
        android:paddingEnd="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        tools:text="Thu 5:02 AM" />

</LinearLayout>
